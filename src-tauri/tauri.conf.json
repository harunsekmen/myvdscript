{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Script Atölyesi",
  "version": "0.2.0",
  "identifier": "com.omerg.scriptatolyesi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Script Atölyesi",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$DATA/ScriptAtolyesi/projects/**/*"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
   },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/harunsekmen/myvdscript/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzQjlGMjAxM0M2RTEyQzEKUldUQkVtNDhBZks1Z3ltVFd2OEpsTHNnd2ZBMjMybHBmbC9LNXJibG1VcjhBVmFZaTdBYjh0UVUK"
    }
  }
}
